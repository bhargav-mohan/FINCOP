# Copy this file to `.env`. Uncomment ONE block. Replace PASTE_HERE with the key.
# Never commit `.env`. Matching and the cash close never use these keys.

# --- Gemini ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=PASTE_HERE
# GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=PASTE_HERE
# OPENAI_MODEL=gpt-4o-mini

# --- Claude ---
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=PASTE_HERE
# CLAUDE_MODEL=claude-sonnet-4-6

# --- GLM via OpenRouter ---
# LLM_PROVIDER=glm
# OPENROUTER_API_KEY=PASTE_HERE
# GLM_MODEL=google/gemma-4-31b-it:free
# GLM_MODELS=google/gemma-4-31b-it:free,minimax/minimax-m2.7:free,z-ai/glm-5.2:free

# --- GLM via Z.ai ---
# LLM_PROVIDER=glm
# ZAI_API_KEY=PASTE_HERE
# GLM_MODEL=glm-5.2

# Optional local SQLite (default data/finance_controller.db)
# FC_DB_PATH=data/finance_controller.db

# Razorpay keys are not required.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
