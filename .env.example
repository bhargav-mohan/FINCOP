# Copy this file to `.env` in this directory. `.env` is gitignored.
# Never paste a real key into this example file or into source code.

# GLM 5.2 via OpenRouter (key starts with sk-or-v1-)
LLM_PROVIDER=glm
OPENROUTER_API_KEY=
GLM_MODEL=z-ai/glm-5.2

# Or GLM 5.2 via Z.ai directly:
# LLM_PROVIDER=glm
# ZAI_API_KEY=
# GLM_MODEL=glm-5.2

# Optional Gemini instead:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Local SQLite path for run history, aging, and notes.
# Defaults to data/finance_controller.db (created on first run).
# Reset with: rm data/finance_controller.db
# FC_DB_PATH=data/finance_controller.db

# Razorpay API keys are NOT required. Demo and tests use
# fixtures/razorpay_sample/. Leave these blank.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
